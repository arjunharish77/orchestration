NODE_ENV=development

POSTGRES_DB=unnatify_crm
POSTGRES_USER=unnatify_user
POSTGRES_PASSWORD=Unnatify@2026
DATABASE_URL=postgresql://unnatify_user:change_me@localhost:5432/unnatify_crm

REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_DAYS=30
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_SECONDS=900

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production Docker builds bake this value into the browser bundle.
# Example production value: https://api.unnatify.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set this in production when app and API are on sibling subdomains.
# Example: .unnatify.com
CSRF_COOKIE_DOMAIN=
PORT=4000
CSV_MAX_FILE_BYTES=26214400
CSV_MAX_ROWS=50000

# Docker production mounts should point these at persistent volumes.
UPLOAD_DIR=/app/uploads
LOG_DIR=/app/logs
LOG_LEVEL=info

AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_DELETE_ENABLED=false
CONNECTOR_EVENT_RETENTION_DAYS=365
AUTOMATION_LOG_RETENTION_DAYS=365
UPLOADED_FILE_RETENTION_DAYS=365
REPORT_EXPORT_RETENTION_DAYS=180
TELEPHONY_RECORD_RETENTION_DAYS=365

RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_OTP_ENABLED=false

OPS_LOGIN_ENABLED=false
OPS_EMAIL=
OPS_PASSWORD_HASH=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PHONE=
SEED_DEMO_DATA=false
HEALTH_METRICS_PUBLIC=false

# Optional local smoke-test credentials. Do not set these in production unless
# you intentionally run smoke tests against that environment.
TEST_ADMIN_EMAIL=arjukannu@gmail.com
TEST_ADMIN_PASSWORD=ChangeMe123!
