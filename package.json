{
  "name": "unnatify-crm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24",
    "npm": ">=10"
  },
  "workspaces": [
    "backend",
    "frontend",
    "workers"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:deploy": "npm run prisma:deploy -w backend",
    "prisma:status": "npm run prisma:status -w backend",
    "seed": "npm run seed -w backend"
  },
  "overrides": {
    "@nestjs/common": "11.1.19",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.19"
  }
}
